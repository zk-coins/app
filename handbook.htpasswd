# LOCAL-DEV-ONLY PLACEHOLDER — not a secret, not used for real deploys.
#
# This bcrypt hash is a dummy credential checked in only so `docker build`
# and local nginx runs succeed without any secret material. It is NEVER
# used for a real DEV/PRD deploy: .github/workflows/handbook-deploy.yaml
# overwrites this file with the real basic-auth file materialized from the
# HANDBOOK_HTPASSWD repository secret before building the deploy image, and
# fails the deploy loudly if that secret is missing.
#
# To generate real credentials for a local test:
#   htpasswd -nbBC 10 <user> <pass>
#
# user: handbook / pass: password (well-known public dummy hash, not a deploy secret; see above)
handbook:$2y$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi
